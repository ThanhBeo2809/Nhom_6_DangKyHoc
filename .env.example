NODE_ENV=development
PORT=3000
FRONTEND_ORIGINS=http://localhost:3000

JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

FORCE_SQLITE=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=pka_portal
DB_SYNC_FORCE=false
SEED_DEMO_DATA=false
CURRENT_SEMESTER=HK1-2025

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PKA Portal <no-reply@pka.edu.vn>

SEPAY_API_TOKEN=
SEPAY_ACCOUNT_NUMBER=
SEPAY_WEBHOOK_SECRET=
# Chỉ bật tạm thời khi demo cục bộ. Luôn bị vô hiệu hóa trong NODE_ENV=production.
ALLOW_PAYMENT_SIMULATION=false
